# ========================================
# SUPABASE DATABASE CONFIGURATION
# ========================================
# Get these from: Supabase Dashboard → Project Settings → API
# Required for all environments

# Your Supabase project URL
# Example: https://abcd1234.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anon/public API key
# WARNING: Use the ANON/PUBLIC key only, never expose the service_role key
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=your-anon-key

# ========================================
# SERVER CONFIGURATION
# ========================================
# Optional: Port for the Express server (default: 3001)
PORT=3001

# Optional: Environment type (development, production)
# Set to 'development' for local dev, 'production' for Render deployment
NODE_ENV=development

